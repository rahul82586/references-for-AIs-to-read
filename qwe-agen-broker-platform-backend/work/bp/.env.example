# ============================================================================
# Broker Platform environment — copy to .env and fill in. `.env` is gitignored.
# The server REFUSES TO START without SECRET_KEY and ADMIN_API_KEY (fail-hard).
# ============================================================================

# --- required for server startup -------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate: python3 -c "import secrets; print(secrets.token_hex(24))"
ADMIN_API_KEY=

# --- data stores -------------------------------------------------------------
# PostgreSQL (async). A plain postgresql:// URL (e.g. copied from Neon) is
# accepted and normalised to postgresql+asyncpg:// automatically.
# Local dev default (docker compose):
# NOTE: if your URL contains & (e.g. Neon's ?sslmode=require&channel_binding=...),
# wrap the whole value in double quotes so shell `source .env` keeps it intact.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broker_platform

# Redis (optional). Set to enable the distributed event bus (multi-node).
# TLS URLs (rediss://, e.g. Upstash) are supported. Unset = single-process
# InProcessEventBus, which is correct for one node.
REDIS_URL=

# --- optional ----------------------------------------------------------------
# Price source. Unset = none: the server runs but refuses orders it cannot
# price (honest). 'mock' = simulated random-walk ticks, every tick labelled
# source=MOCK - development and testing only. 'trade_server' = LIVE ticks from
# a trade-server WebSocket upstream (a box with a real MT5 terminal attached),
# labelled source=TRADE_SERVER. Unknown values refuse to boot.
MARKET_DATA_SOURCE=
# MOCK_TICK_RATE_MS=250

# --- live market data (MARKET_DATA_SOURCE=trade_server) ----------------------
# Required for that source; the server refuses to boot without it. This is the
# trade-server's /ws/marketdata endpoint (msgpack frames, JSON sub actions).
# TRADE_SERVER_WS_URL=ws://127.0.0.1:8000/ws/marketdata
# Which symbols to subscribe. Unset = the seeded symbol list, capped by
# TRADE_SERVER_WS_MAX_SYMBOLS - a terminal chokes if you select all 362 at once.
# TRADE_SERVER_WS_SYMBOLS=EURUSD,GBPUSD,XAUUSD
# TRADE_SERVER_WS_MAX_SYMBOLS=50

# --- A-Book liquidity (external LP hedging) ---------------------------------
# Unset = the StubLiquidityGateway: A-Book orders are rejected rather than
# silently unhedged. 'fix' = the FIX 4.4 gateway.
# BROKER_LP_GATEWAY=fix
# FIX_SENDER_COMP_ID=BROKER
# FIX_TARGET_COMP_ID=LP
# FIX_HOST=            # required for a real session; refuses to build without it
# FIX_PORT=5000
# FIX_ACCOUNT=         # optional, FIX tag 1
# FIX_ORDER_TIMEOUT_S=5
# Dev/test only: an in-process simulated LP instead of a real FIX session.
# It fills at its own prices and moves no money - the log says so on every boot.
# BROKER_FIX_SIMULATOR=1
# Quote prices as STRINGS: JSON floats lose trailing zeros (1.10000 -> 1.1).
# FIX_SIM_PRICES={"EURUSD": ["1.10000", "1.10010"]}

# Directory of decoded MT5 export JSON; enables the MT5 round-trip tests.
# BROKER_MT5_FIXTURES=
